[flake8]
max-line-length = 999
exclude = 
    __pycache__,
    .git,
    venv,
    env,
    migrations
ignore =
    E101,
    E111,
    E114,
    E117,
    E128,
    E201,
    E202,
    E203,
    E211,
    E225,
    E226,
    E228,
    E231,
    E241,
    E251,
    E261,
    E262,
    E265,
    E266,
    E271,
    E272,
    E302,
    E303,
    E304,
    E305,
    E306,
    E401,
    E402,
    E501,
    E502,
    E701,
    E702,
    E703,
    E711,
    E712,
    E714,
    E721,
    E722,
    E731,
    E741,
    W191,
    W291,
    W292,
    W293,
    W391,
    W503,
    W504,
    W605,
    F401,
    F811,
    F841
